# WebUI & Network Port Configuration
WEB_PORT=8080
VNC_PORT=5900
SSH_PORT=2222

# Display Resolution (WIDTHxHEIGHTxDEPTH)
RESOLUTION=1920x1080x24

# Linux 'antigravity' user password (for SSH and sudo)
USER_PASSWORD=antigravity

# VNC password (leave empty for passwordless browser access)
VNC_PASSWORD=

# Volume Mount for User Project Data
# Map a local folder to /projects inside the container
PROJECT_DATA_PATH=./projects

# Antigravity Remote Mode Autostart
# Automatically run the background remote daemon ('agy remote-control serve')
AUTORUN_ANTIGRAVITY_REMOTE=true

# Automatically open an interactive Antigravity terminal inside the desktop GUI
AUTORUN_DESKTOP_TERMINAL=true

# Identifier for this machine in the Antigravity remote dashboard
ANTIGRAVITY_INSTANCE_NAME=antigravity-docker

# Extra arguments to pass to agy remote-control serve (e.g. --dangerously-skip-permissions)
EXTRA_AGY_ARGS=

# NVIDIA GPU Configuration (used when running with GPU access)
NVIDIA_VISIBLE_DEVICES=all
NVIDIA_DRIVER_CAPABILITIES=all

